{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "incremental": false,
    // Node runs these files by stripping types, so only erasable syntax is allowed
    // and type-only imports must say so.
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["./**/*.ts"],
  "exclude": []
}
